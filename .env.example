# Which network the registry lives on: testnet (default, chain 968), mainnet (677) or local (Anvil, 31337).
NEXT_PUBLIC_LOXEN_CHAIN=testnet
# ResearchReceiptRegistry address from `forge script script/Deploy.s.sol`. Leave empty until deployed:
# the Registry, History and Profile screens then say receipts cannot be committed or read.
NEXT_PUBLIC_LOXEN_REGISTRY_ADDRESS=
# Only for NEXT_PUBLIC_LOXEN_CHAIN=local
# NEXT_PUBLIC_LOXEN_LOCAL_RPC=http://127.0.0.1:8545
